{
  "name": "playwright-bdd-salesforce",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "npm run build && npx cucumber-js --config cucumber.js --format pretty",
    "test:allure": "npx cucumber-js --config cucumber.js --profile allure --format pretty",
    "test:headed": "HEADLESS=false npx cucumber-js --config cucumber.js --format pretty",
    "test:allure:generate": "npx allure generate ./allure-results --clean -o ./allure-report",
    "test:allure:open": "npx allure open ./allure-report",
    "test:report": "npx playwright show-report",
    "test:tag": "npx cucumber-js --config cucumber.js --tags"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.65.0",
    "@tsconfig/recommended": "^1.0.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.10",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.14.0",
    "dotenv": "^18.0.9",
    "playwright": "^1.65.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0"
  }
}
